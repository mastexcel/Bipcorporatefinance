# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais committer .env.local.

# URL publique du site (sans barre oblique finale), utilisée pour le SEO et les e-mails
NEXT_PUBLIC_SITE_URL=https://corporatefinance.bridgeinvestmentpartners.net

# --- E-mails (Resend : https://resend.com) ---
RESEND_API_KEY=
# Expéditeur : adresse d'un domaine vérifié dans Resend
EMAIL_FROM="BIP Corporate Finance <contact@bridgeinvestmentpartners.net>"
# Adresse(s) de réception des demandes (séparées par des virgules)
EMAIL_TO=contact@bridgeinvestmentpartners.net

# --- Anti-spam Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Mesure d'audience (chargée uniquement après consentement) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- WhatsApp : numéro au format international, chiffres uniquement ---
# Facultatif : par défaut, le numéro de BIP (config/site.ts) est utilisé.
NEXT_PUBLIC_WHATSAPP_NUMBER=2250584374848
