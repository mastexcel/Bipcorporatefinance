# Copier ce fichier en .env.local et renseigner les valeurs.
# Ne jamais committer .env.local.

# URL publique du site (sans barre oblique finale), utilisée pour le SEO et les e-mails
NEXT_PUBLIC_SITE_URL=https://www.bip-corporatefinance.com

# --- E-mails (Resend : https://resend.com) ---
RESEND_API_KEY=
# Expéditeur : adresse d'un domaine vérifié dans Resend
EMAIL_FROM="BIP Corporate Finance <contact@votre-domaine.com>"
# Adresse(s) de réception des demandes (séparées par des virgules)
EMAIL_TO=

# --- Anti-spam Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Mesure d'audience (chargée uniquement après consentement) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- WhatsApp : numéro au format international, chiffres uniquement (ex. 2250700000000) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=
