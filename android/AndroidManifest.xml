<?xml version="1.0" encoding="utf-8"?>
<!-- Application Android de BIP Corporate Finance : le site officiel en plein écran. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.bridgeinvestmentpartners.corporatefinance"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/nom_app"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.BIP"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
